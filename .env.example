# Lethus Configuration
# Copy to .env and customize

# === Mode ===
# LETHUS_MODE=both  # mcp, api, or both

# === REST API ===
LETHUS_API_HOST=0.0.0.0
LETHUS_API_PORT=8000
LETHUS_CORS_ORIGINS=http://localhost:3000

# === PostgreSQL (for REST API) ===
LETHUS_POSTGRES_HOST=localhost
LETHUS_POSTGRES_PORT=5432
LETHUS_POSTGRES_DB=lethus_db
LETHUS_POSTGRES_USER=postgres
LETHUS_POSTGRES_PASSWORD=postgres

# === Milvus Vector Store ===
LETHUS_MILVUS_URI=http://localhost:19530
LETHUS_MILVUS_COLLECTION=lethus_memory

# === Embeddings ===
# Provider: "local" (sentence-transformers) or "openai"
LETHUS_EMBEDDING_PROVIDER=openai

# Local models (pick one):
#   all-MiniLM-L6-v2        (384d, 80MB)   - lightweight, fast
#   nomic-ai/nomic-embed-text-v1.5 (768d, 550MB)  - recommended
#   BAAI/bge-m3             (1024d, 2.2GB) - best quality, multilingual
# LETHUS_LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# LETHUS_LOCAL_EMBEDDING_DIM=768

# OpenAI models (pick one):
#   text-embedding-3-small  (1536d, $0.02/1M tokens) - recommended
#   text-embedding-3-large  (3072d, $0.13/1M tokens) - highest quality
LETHUS_OPENAI_API_KEY=sk-...
LETHUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LETHUS_OPENAI_EMBEDDING_DIM=1536

# === DYCP Algorithm (from paper) ===
LETHUS_DYCP_TAU=0.6
LETHUS_DYCP_THETA=1.0

# === Semantic Decay ===
LETHUS_DECAY_LAMBDA=0.98

# === Ghost Graph ===
LETHUS_USE_SPACY=true
LETHUS_GHOST_GRAPH_BOOST=1.2

# === Prefetch Cache ===
LETHUS_PREFETCH_ENABLED=true
LETHUS_PREFETCH_CACHE_SIZE=50
LETHUS_PREFETCH_TTL=60.0

# === Context Processing ===
LETHUS_MAX_CONTEXT_TOKENS=8000
LETHUS_IMPORTANCE_THRESHOLD=0.7
LETHUS_CONFIDENCE_THRESHOLD=0.3

# === LLM (for REST API chat) ===
# Models: gpt-4o-mini (cheap), gpt-4o (best), claude-3-5-sonnet (if using Anthropic)
LETHUS_LLM_MODEL=gpt-4o-mini
LETHUS_LLM_TEMPERATURE=0.7
LETHUS_LLM_MAX_TOKENS=1000

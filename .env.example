# Lethus Configuration
# Copy to .env and fill in your values

# ============ REQUIRED ============

# OpenAI API key (or GitHub Models PAT)
LETHUS_OPENAI_API_KEY=sk-your-key-here

# For Coolify/production: set your domains
# LETHUS_CORS_ORIGINS=https://lethus.yourdomain.com
# NEXT_PUBLIC_API_URL=https://lethus-api.yourdomain.com

# ============ API & DATABASE ============

LETHUS_API_HOST=0.0.0.0
LETHUS_API_PORT=8000
LETHUS_CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Docker uses service names, local uses localhost)
LETHUS_POSTGRES_HOST=localhost
LETHUS_POSTGRES_PORT=5432
LETHUS_POSTGRES_DB=lethus_db
LETHUS_POSTGRES_USER=postgres
LETHUS_POSTGRES_PASSWORD=postgres

# Milvus Vector Store
LETHUS_MILVUS_URI=http://localhost:19530
LETHUS_MILVUS_COLLECTION=lethus_memory

# ============ OPENAI / LLM ============

# Base URL options:
#   OpenAI: https://api.openai.com/v1
#   GitHub Models: https://models.github.ai/inference
LETHUS_OPENAI_BASE_URL=https://api.openai.com/v1
LETHUS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LETHUS_OPENAI_EMBEDDING_DIM=1536

LETHUS_LLM_MODEL=gpt-4o-mini
LETHUS_LLM_TEMPERATURE=0.7
LETHUS_LLM_MAX_TOKENS=1000

# ============ DYCP ALGORITHM ============

LETHUS_DYCP_TAU=0.6
LETHUS_DYCP_THETA=1.0
LETHUS_DECAY_LAMBDA=0.98

# ============ GHOST GRAPH ============

LETHUS_USE_SPACY=true
LETHUS_GHOST_GRAPH_BOOST=1.5
LETHUS_GHOST_GRAPH_ADDITIVE_BOOST=0.35

# ============ PREFETCH & CONTEXT ============

LETHUS_PREFETCH_ENABLED=true
LETHUS_PREFETCH_CACHE_SIZE=50
LETHUS_PREFETCH_TTL=60.0
LETHUS_MAX_CONTEXT_TOKENS=8000
LETHUS_IMPORTANCE_THRESHOLD=0.7
LETHUS_CONFIDENCE_THRESHOLD=0.3

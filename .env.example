# DYCP Memory Server Configuration

# Milvus endpoint (local Lite or cluster)
# Local (default): ./milvus.db
# Cluster: http://localhost:19530
DYCP_MILVUS_URI=./milvus.db

# Semantic decay factor (0.98 = 2% decay per turn, older messages need higher relevance)
# Range: 0.9-0.99 (lower = faster decay, higher = longer memory)
DYCP_DECAY_LAMBDA=0.98

# Embedding model from sentence-transformers
# Lightweight options: all-MiniLM-L6-v2 (384 dim, fast), all-MiniLM-L12-v2 (384 dim)
# Stronger: all-mpnet-base-v2 (768 dim, slower), all-roberta-large-v1 (1024 dim)
DYCP_EMBEDDING_MODEL=all-MiniLM-L6-v2
